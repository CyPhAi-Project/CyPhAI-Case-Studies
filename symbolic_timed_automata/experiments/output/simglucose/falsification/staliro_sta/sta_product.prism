pta
module m
	state:[0..6] init 0;
	h:clock;
	t:clock;
	d:clock;
	[breakfast_to_snack_1] (state=0) & (h>=5)&(h<=6) -> (0.5) : (state'=1) & (d'=0)&(t'=0);
	[breakfast_to_lunch] (state=0) & (h>=6)&(h<=9) -> (0.5) : (state'=4) & (d'=0)&(t'=0);
	[snack_1_to_lunch] (state=1) & (h>=9)&(h<=11) -> (1.0) : (state'=5) & (t'=0);
	[snack3_to_breakfast] (state=2) & (h>=20)&(h<=23) -> (1.0) : (state'=0) & (d'=0)&(h'=0)&(t'=0);
	[dinner_to_breakfast_no_snack_3] (state=3) & (h>=17)&(h<=21)&(d>=5)&(d<=7) -> (0.5) : (state'=0) & (d'=0)&(h'=0)&(t'=0);
	[dinner_to_snack_3] (state=3) & (h>=16)&(h<=17)&(d>=4)&(d<=6) -> (0.5) : (state'=2) & (t'=0);
	[lunch_to_snack_2_no_snack_1] (state=4) & (h>=12)&(h<=13)&(d>=3)&(d<=6) -> (1.0) : (state'=6) & (d'=0)&(t'=0);
	[lunch_to_snack_2_with_s1] (state=5) & (h>=12)&(h<=13)&(d>=6)&(d<=7) -> (0.5) : (state'=6) & (d'=0)&(t'=0);
	[lunch_with_snack_1_to_dinner] (state=5) & (h>=12)&(h<=15)&(d>=4)&(d<=7) -> (0.5) : (state'=3) & (d'=0)&(t'=0);
	[snack_2_to_dinner] (state=6) & (h>=14)&(h<=16) -> (1.0) : (state'=3) & (t'=0);
endmodule
