pta
module m
	state:[0..5] init 3;
	t:clock;
	d:clock;
	h:clock;
	[to_breakfast] (state=0) & (h>=19)&(h<=22)&(d>=5)&(d<=7) -> (1.0) : (state'=3) & (d'=0)&(h'=0)&(t'=0);
	[snack_to_dinner] (state=1) & (h>=14)&(h<=16) -> (1.0) : (state'=0) & (t'=0);
	[to_snack_2_wo_s1] (state=2) & (h>=12)&(h<=15)&(d>=4)&(d<=6) -> (1.0) : (state'=1) & (d'=0)&(t'=0);
	[to_snack_1] (state=3) & (h>=5)&(h<=9) -> (0.5) : (state'=4) & (d'=0)&(t'=0);
	[to_lunch] (state=3) & (h>=5)&(h<=9) -> (0.5) : (state'=2) & (d'=0)&(t'=0);
	[snack_to_lunch] (state=4) & (h>=9)&(h<=11) -> (1.0) : (state'=5) & (t'=0);
	[to_snack_2_w_s1] (state=5) & (h>=12)&(h<=15)&(d>=4)&(d<=6) -> (0.5) : (state'=1) & (d'=0)&(t'=0);
	[to_dinner] (state=5) & (h>=12)&(h<=15)&(d>=4)&(d<=6) -> (0.5) : (state'=0) & (d'=0)&(t'=0);
endmodule
